// Prisma 7 + PostgreSQL (Supabase).
// Connection URLs live in prisma.config.ts, not here.
// Runtime app uses DATABASE_URL (pooled). CLI / migrate must use DIRECT_URL.

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  MANAGER
  BARISTA
}

enum InventoryUnit {
  PIECE
  GRAM
  KILOGRAM
  MILLILITER
  LITER
  PACK
}

enum StockMovementType {
  RECEIPT
  USAGE
  ADJUSTMENT
  WASTE
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime? @map("email_verified")
  image         String?
  passwordHash  String?   @map("password_hash")
  role          UserRole  @default(BARISTA)
  isActive      Boolean   @default(true) @map("is_active")

  accounts       Account[]
  sessions       Session[]
  expenses       Expense[]
  stockMovements StockMovement[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([role])
  @@map("users")
}

model Account {
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@id([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  sessionToken String   @id @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@id([identifier, token])
  @@map("verification_tokens")
}

model Category {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  sortOrder Int       @default(0) @map("sort_order")
  isActive  Boolean   @default(true) @map("is_active")

  products  Product[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@index([isActive, sortOrder])
  @@map("categories")
}

model Product {
  id             String   @id @default(cuid())
  name           String
  description    String?
  /// Ціна в копійках (UAH × 100). Приклад: 65.00 ₴ → 6500
  priceInKopecks Int      @map("price_in_kopecks")
  imageUrl       String?  @map("image_url")
  isActive       Boolean  @default(true) @map("is_active")
  isAvailable    Boolean  @default(true) @map("is_available")
  sortOrder      Int      @default(0) @map("sort_order")

  categoryId     String   @map("category_id")
  category       Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@index([categoryId, isActive, isAvailable, sortOrder])
  @@index([isActive, isAvailable])
  @@map("products")
}

model InventoryCategory {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")

  items InventoryItem[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([isActive, sortOrder])
  @@map("inventory_categories")
}

model InventoryItem {
  id              String         @id @default(cuid())
  name            String
  unit            InventoryUnit
  minimumQuantity Decimal        @db.Decimal(12, 3) @map("minimum_quantity")
  sortOrder       Int            @default(0) @map("sort_order")
  isActive        Boolean        @default(true) @map("is_active")
  note            String?

  categoryId String            @map("category_id")
  category   InventoryCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  stockMovements StockMovement[]
  expenses       Expense[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([categoryId, isActive, sortOrder])
  @@map("inventory_items")
}

model Expense {
  id        String  @id @default(cuid())
  title     String
  category  String
  quantity  Decimal @db.Decimal(12, 3)
  unit      String
  unitCost  Decimal @db.Decimal(12, 2) @map("unit_cost")
  totalCost Decimal @db.Decimal(12, 2) @map("total_cost")
  supplier  String?
  notes     String?
  purchasedAt DateTime @map("purchased_at")

  createdById String @map("created_by_id")
  createdBy   User   @relation(fields: [createdById], references: [id], onDelete: Restrict)

  inventoryItemId String?        @map("inventory_item_id")
  inventoryItem   InventoryItem? @relation(fields: [inventoryItemId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([category])
  @@index([purchasedAt])
  @@index([inventoryItemId])
  @@index([createdById])
  @@index([createdAt])
  @@map("expenses")
}

model StockMovement {
  id            String            @id @default(cuid())
  type          StockMovementType
  quantityDelta Decimal           @db.Decimal(12, 3) @map("quantity_delta")
  note          String?

  inventoryItemId String        @map("inventory_item_id")
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)

  createdById String? @map("created_by_id")
  createdBy   User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([inventoryItemId, createdAt])
  @@map("stock_movements")
}
